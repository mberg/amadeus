# Amadeus Environment Variables
# This file contains ONLY secrets. Non-sensitive configuration goes in amadeus.config.yaml.
#
# Copy this file to .env and add your actual secret values.

# Linear API keys (one per realm)
# These are referenced by apiKeyEnvVar in amadeus.config.yaml
LINEAR_API_KEY_ONA=lin_api_your_key_here
# LINEAR_API_KEY_RECODE=lin_api_another_key_here

# Linear webhook secrets (one per realm)
# These are referenced by webhookSecretEnvVar in amadeus.config.yaml
LINEAR_WEBHOOK_SECRET_ONA=your_webhook_secret_here
# LINEAR_WEBHOOK_SECRET_RECODE=another_webhook_secret_here

# Optional: API authentication for dashboard endpoints in simple mode
# (generate with: openssl rand -hex 32)
# AMADEUS_API_TOKEN=your_secure_token_here

# Optional: Better Auth for session-based authentication
# When set, enables sign-in via email/password and OAuth providers
# (generate with: openssl rand -hex 32)
# BETTER_AUTH_SECRET=your_secret_here
# BETTER_AUTH_URL=http://localhost:5678

# Optional: GitHub OAuth (for "Sign in with GitHub" button)
# Create at: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your_client_id
# GITHUB_CLIENT_SECRET=your_client_secret

# Optional: Google OAuth (for "Sign in with Google" button)
# Create at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret

# Postgres database URL (required for hub/cloud mode)
# DATABASE_URL=postgres://localhost/amadeus_hub

# Optional: Email notifications (if using Resend)
RESEND_API_KEY=re_your_key_here
NOTIFICATION_EMAIL=your_phone@carrier.net
NOTIFICATION_FROM_EMAIL=amadeus@yourdomain.com
