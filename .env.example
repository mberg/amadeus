# Required
LINEAR_WEBHOOK_SECRET=your_linear_signing_secret

# Optional - API authentication (generate with: openssl rand -hex 32)
# When set, /status, /config, /trigger, and /agents/:key/messages require X-Amadeus-Token header
AMADEUS_API_TOKEN=

# Optional
LINEAR_API_KEY=your_api_key
CLAUDE_BOT_USER_ID=optional_user_id_for_assignment_trigger
PORT=5678

# Project path mappings (format: TEAM_KEY:/path/to/project)
PROJECT_PATHS=ONA:/Users/matt/code/ona,RECODE:/Users/matt/code/recode-labs

# Fallback if no PROJECT_PATHS set
DEFAULT_PROJECT_PATH=/tmp/amadeus-default

# Workflow states that trigger agent spawn (comma-separated)
TRIGGER_STATES=Planning

# Linear workspace slug for @mentions (e.g., "ona" for linear.app/ona)
LINEAR_WORKSPACE=ona

# Git worktrees (enabled by default)
# USE_WORKTREES=true
WORKTREES_DIR=/path/to/.amadeus-worktrees

# Agent profiles (optional)
# PROFILES_DIR=./agent-profiles
# DEFAULT_PROFILE=base
# TEAM_PROFILES=ONA:base,DESIGN:frontend

# Persistence & health monitoring (have sensible defaults)
# DB_PATH=./amadeus-agents.db
# HEALTH_CHECK_INTERVAL_MS=30000
# HEALTH_CHECK_TIMEOUT_MS=5000
