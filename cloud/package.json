{
  "name": "amadeus-cloud",
  "private": true,
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun run css:build && bun --hot src/server.ts",
    "test": "bun test",
    "css:build": "tailwindcss -i src/dashboard/styles.css -o src/dashboard/index.css --minify",
    "css:watch": "tailwindcss -i src/dashboard/styles.css -o src/dashboard/index.css --watch",
  },
  "dependencies": {
    "better-auth": "^1.4.18",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "lucide-react": "^0.562.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.5",
    "tailwindcss": "3",
    "typescript": "^5"
  }
}
